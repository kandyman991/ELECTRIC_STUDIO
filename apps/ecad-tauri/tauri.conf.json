{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electric Studio (Tauri)",
  "version": "0.0.1",
  "identifier": "io.github.kandyman991.electricstudio.tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Electric Studio (Tauri)",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "shortDescription": "Electrical CAD (M1b test build)",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
